      "url": "/?action=new-expense",
      "icons": [{ "src": "/pwa-192x192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Giroconto Rapido",
      "short_name": "Giroconto",
      "description": "Trasferisci denaro tra i tuoi conti",
      "url": "/?action=transfer",
